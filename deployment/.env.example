# Used by Docker Compose only. Windows local startup uses ports 8080 and 8000.
HTTP_PORT=80
HTTP_BIND=0.0.0.0
# Requests through Nginx use the same origin; these origins are for direct API development.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# For optional HTTPS: set DOMAIN, HTTP_BIND=127.0.0.1 and HTTP_PORT=8080.
# DOMAIN=calculator.example.com
